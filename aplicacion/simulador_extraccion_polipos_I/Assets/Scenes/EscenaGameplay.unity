    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 0
  - nombrePaso: 23
    instruccion: "Has encontrado varios p\xF3lipos, siempre se recomienda revisar
      el intestino completo para una revision completa y optima."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: 24
    instruccion: "Cuando est\xE9s listo, regresa a la salida/zona de extracci\xF3n."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
