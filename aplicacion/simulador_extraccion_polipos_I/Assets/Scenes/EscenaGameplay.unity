--- !u!114 &1134385070
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1134385068}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0596270b19c15534f94977ccd9f0e093, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  controlesBloqueados: 0
  pasos:
  - nombrePaso: paso 0
    instruccion: "Te doy la bienvenida al simulador para la extracci\xF3n de p\xF3lipos
      intestinales. Te acompa\xF1ar\xE9 a trav\xE9s de los elementos para que entiendas
      su funci\xF3n."
    uiAResaltar: {fileID: 0}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 0
  - nombrePaso: paso 1
    instruccion: "Panel Izquierdo: contar\xE1s con la informaci\xF3n del Doctor,
      la fecha y el nivel de dificultad."
    uiAResaltar: {fileID: 689849874}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 0
  - nombrePaso: paso 2
    instruccion: "Cuentas con la informaci\xF3n de telemetr\xEDa Profundidad (cm
      insertados)"
    uiAResaltar: {fileID: 689849874}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 0
  - nombrePaso: paso 3
    instruccion: "Consola de respuestas Aqu\xED ver\xE1s el historial de tus acciones
      y errores."
    uiAResaltar: {fileID: 1973696619}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 0
  - nombrePaso: paso 4
    instruccion: "Gu\xEDa de Control de Imagen: la imagen te mostrar\xE1 la ubicaci\xF3n
      de los botones para que, si te confundes, puedas orientarte."
    uiAResaltar: {fileID: 756089729}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 0
  - nombrePaso: paso 5
    instruccion: "Panel Azul: Muestra la funci\xF3n actual de tus botones; debes
      estar atento a ellos, puesto que el simulador los usar\xE1 para simular acciones
      de tus enfermeras."
    uiAResaltar: {fileID: 445210974}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 0
  - nombrePaso: paso 6
    instruccion: "Panel Morado: Muestra la calificaci\xF3n de las 3 \xE1reas principales
      y el conteo de p\xF3lipos."
    uiAResaltar: {fileID: 1948923969}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 0
  - nombrePaso: paso 7
    instruccion: "Indicador de Da\xF1o: Muestra la tensi\xF3n o fricci\xF3n sobre
      el tejido debes estar atento de no forzarlo demasiado sino lastimaras al paciente."
    uiAResaltar: {fileID: 113892073}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 0
  - nombrePaso: paso 8
    instruccion: "Gu\xEDa contextual: Este elemento te dar\xE1 instrucciones paso
      a paso para que te sirva de gu\xEDa en las dificultades bajas."
    uiAResaltar: {fileID: 970984854}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 0
  - nombrePaso: paso 9
    instruccion: "Con eso concluimos con la interfaz. Empecemos: empuja el tubo para
      realizar la inserci\xF3n o w si est\xE1s en modo por computadora."
    uiAResaltar: {fileID: 0}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: W
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 0
  - nombrePaso: paso 10
    instruccion: "Ahora jala el tubo para practicar la extracci\xF3n o si est\xE1s
      en modo por computadora."
    uiAResaltar: {fileID: 0}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: S
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 0
  - nombrePaso: paso 10.1
    instruccion: "Debes tener cuidado con la extracci\xF3n del tubo, ya que generas
      fricci\xF3n en el paciente; ten cuidado con el da\xF1o que le haces."
    uiAResaltar: {fileID: 113892073}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 0
  - nombrePaso: paso 10.2
    instruccion: "Si en la inserci\xF3n o extracci\xF3n generas un BUCLE, se te indicar\xE1
      en las dificultades m\xE1s bajas. Para salir de un BUCLE, haz la rectificaci\xF3n
      (extrayendo y girando el tubo) o presiona S si est\xE1s en modo computadora."
    uiAResaltar: {fileID: 1504859466}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: paso 10.3
    instruccion: "Ahora que conoces la inserci\xF3n y extracci\xF3n, vamos a empezar
      con la b\xFAsqueda de un p\xF3lipo Avanza hasta el p\xF3lipo."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 1822834537}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: 11
    instruccion: 
    uiAResaltar: {fileID: 0}
    espera: 4
    tiempoSegundos: 0
    accionRequerida: 
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 0
  - nombrePaso: 12
    instruccion: "Encontraste un p\xF3lipo Yamada 1; por protocolo debemos tomarle
      una foto, as\xED que presiona Freeze o 1 si est\xE1s en modo computadora para
      congelar la imagen."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 13
    instruccion: "Freeze congelar\xE1 la pantalla; procura no moverte o hacer otra
      acci\xF3n para no recibir penalizaciones en tu calificaci\xF3n."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: 14
    instruccion: "Una vez congelada la imagen, le tomaremos la foto con el bot\xF3n
      Capture o 2 si est\xE1s en modo computadora. "
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Capture
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 15
    instruccion: "Despu\xE9s de tomar la foto, saldremos del modo Freeze; debes volver
      a presionar el bot\xF3n Freeze o 1 si est\xE1s en modo computadora para salir
      del modo Freeze."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 16
    instruccion: Como puedes notar el panel de acciones se va llenando siempre que
      cumplas una accion
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: 16
    instruccion: "Una vez salgas del modo Freeze, procederemos al corte del p\xF3lipo;
      para eso, el simulador te obligar\xE1 a estar en una buena posici\xF3n para
      las pinzas."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: 16.1
    instruccion: "Las pinzas se encuentran en la parte baja del endoscopio; lo puedes
      ver en el c\xEDrculo de ubicaci\xF3n de pinzas."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: 16.2
    instruccion: "Presiona el bot\xF3n de acci\xF3n o 5 si est\xE1s en modo computadora
      para entrar en las opciones de corte."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Accion
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 16.3
    instruccion: "Una vez entres en las opciones de corte, notar\xE1s que en el recuadro
      azul las opciones de botones han cambiado."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: 16.4
    instruccion: "Deber\xE1s escoger la pinza correcta para la acci\xF3n con los
      p\xF3lipos; en las dificultades bajas se te dar\xE1n indicaciones por el panel
      de instrucciones."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: 16.5
    instruccion: "Selecciona la pinza de Biopsia con el bot\xF3n de freeze o 1 si
      est\xE1s en modo computadora."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 16.6
    instruccion: 
    uiAResaltar: {fileID: 0}
    espera: 0
    tiempoSegundos: 3
    accionRequerida: 
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 0
  - nombrePaso: 16.7
    instruccion: "Este tipo de p\xF3lipos sale f\xE1cilmente por el endoscopio; dir\xEDgete
      al siguiente p\xF3lipo."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 298192898}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: 17
    instruccion: 
    uiAResaltar: {fileID: 0}
    espera: 4
    tiempoSegundos: 0
    accionRequerida: 
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 0
  - nombrePaso: 18
    instruccion: "Encontraste un p\xF3lipo Yamada 3; t\xF3male una foto, presiona
      Freeze o 1 si est\xE1s en modo computadora para congelar la imagen."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 18.1
    instruccion: "Una vez congelada la imagen, le tomaremos la foto con el bot\xF3n
      Capture o 2 si est\xE1s en modo computadora. "
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Capture
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 18.2
    instruccion: "Despu\xE9s de tomar la foto, saldremos del modo Freeze; debes volver
      a presionar el bot\xF3n Freeze o 1 si est\xE1s en modo computadora para salir
      del modo Freeze."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 19
    instruccion: "Presiona Acci\xF3n o 5 si est\xE1s en modo computadora para ir
      a selecci\xF3n de pinzas."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Accion
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 19.1
    instruccion: "C\xF3rtalo con el asa de Polipectom\xEDa usando el bot\xF3n capture
      o 2 si est\xE1s en modo computadora."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Capture
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 20
    instruccion: 
    uiAResaltar: {fileID: 0}
    espera: 0
    tiempoSegundos: 5
    accionRequerida: 
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 0
  - nombrePaso: 20.1
    instruccion: "Como puedes notar, hay p\xF3lipos muy grandes como para que salgan
      por el orificio de las pinzas, por lo que deber\xE1s agarrarlos con el asa
      de Polipectom\xEDa."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: 20.2
    instruccion: "Presiona el bot\xF3n de atrapar p\xF3lipo o 1 si est\xE1s en modo
      computadora para succionarlo."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 20.2
    instruccion: 
    uiAResaltar: {fileID: 0}
    espera: 0
    tiempoSegundos: 2
    accionRequerida: Succion
    colliderABloquear: {fileID: 0}
    bloquearControles: 1
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 0
  - nombrePaso: 20.3
    instruccion: "El p\xF3lipo atrapado debe ser sacado del intestino; deber\xE1s
      ir sacando el tubo sin hacer tirones para no lastimar al paciente, o S si est\xE1s
      en modo computadora, para sacar el endoscopio."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: S
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 20.4
    instruccion: 
    uiAResaltar: {fileID: 0}
    espera: 2
    tiempoSegundos: 0
    accionRequerida: 
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 0
  - nombrePaso: 21
    instruccion: "Llegaste a la zona de extracci\xF3n (salida del endoscopio); presiona
      soltar p\xF3lipo o 4 si est\xE1s en modo computadora."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 1
  - nombrePaso: 22
    instruccion: "Como notar\xE1s, en el panel morado se ir\xE1n aumentando los p\xF3lipos
      que hayas sacado; todav\xEDa faltan p\xF3lipos. Ve a buscar los que faltan."
    uiAResaltar: {fileID: 732441917}
    espera: 1
    tiempoSegundos: 0
    accionRequerida: Freeze
    colliderABloquear: {fileID: 2004581900}
    bloquearControles: 1
    mostrarTextoPresionar: 1
    mostrarTemporalmente: 1
  - nombrePaso: 22.1
    instruccion: 
