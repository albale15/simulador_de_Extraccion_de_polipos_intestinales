    espera: 3
    tiempoSegundos: 0
    accionRequerida: 
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
    mostrarTemporalmente: 0
  - nombrePaso: 22.2
    instruccion: 
    uiAResaltar: {fileID: 0}
    espera: 3
    tiempoSegundos: 0
    accionRequerida: 
    colliderABloquear: {fileID: 0}
    bloquearControles: 0
    mostrarTextoPresionar: 0
