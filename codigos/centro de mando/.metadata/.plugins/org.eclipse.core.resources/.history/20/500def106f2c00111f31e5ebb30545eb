/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_I2C3_Init();
  MX_TIM2_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
  // Giroscopio MPU6050 (Registro 0x6B = 0)
  uint8_t wakeup_data = 0x00;
  if(HAL_I2C_Mem_Write(&hi2c3, MPU6050_ADDR, 0x6B, 1, &wakeup_data, 1, 10) != HAL_OK) {
      err_gyro = 1; // Si no responde, marcamos error
  }

  // Encender PWM de Motores en 0% (TIM2)
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1); // PA0
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_2); // PA1
  TIM2->CCR1 = 0; // Motor 1 apagado (0 a 1000)
  TIM2->CCR2 = 0; // Motor 2 apagado

  // Iniciar escucha por Serial (UART2)
  HAL_UART_Receive_IT(&huart2, &rx_byte, 1);

  // Lectura inicial de AS5600
  angulo_anterior_1 = Leer_Angulo_AS5600(&hi2c1);
  angulo_anterior_2 = Leer_Angulo_AS5600(&hi2c3);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
    {
        // 1. BOTONES EN NUEVOS PINES (PA3, PA4, PA6, PA8, PA9)
        btn1 = readButton(GPIOA, GPIO_PIN_3, &b1_last);
        btn2 = readButton(GPIOA, GPIO_PIN_4, &b2_last);
        btn3 = readButton(GPIOA, GPIO_PIN_6, &b3_last);
        btn4 = readButton(GPIOA, GPIO_PIN_8, &b4_last);
        btn_suction = readButton(GPIOA, GPIO_PIN_9, &bs_last);

        // 2. LECTURA DE ENCODERS MAGNÉTICOS
        uint16_t angulo_actual_1 = Leer_Angulo_AS5600(&hi2c1);
        uint16_t angulo_actual_2 = Leer_Angulo_AS5600(&hi2c3);

        if(angulo_actual_1 == 0 && angulo_actual_2 == 0) err_encoder = 1;
        else err_encoder = 0;

        int16_t diff_1 = angulo_actual_1 - angulo_anterior_1;
        int16_t diff_2 = angulo_actual_2 - angulo_anterior_2;

        if (diff_1 > 2048) diff_1 -= 4096;
        if (diff_1 < -2048) diff_1 += 4096;
        if (diff_2 > 2048) diff_2 -= 4096;
        if (diff_2 < -2048) diff_2 += 4096;

        angulo_anterior_1 = angulo_actual_1;
        angulo_anterior_2 = angulo_actual_2;

        enc1_accumulator += diff_1;
        enc2_accumulator += diff_2;

        if (enc1_accumulator >= MAGNETIC_THRESHOLD) {
            enc1_send = 1; enc1_accumulator -= MAGNETIC_THRESHOLD; activate = 1;
        } else if (enc1_accumulator <= -MAGNETIC_THRESHOLD) {
            enc1_send = -1; enc1_accumulator += MAGNETIC_THRESHOLD; activate = 1;
        }

        if (enc2_accumulator >= MAGNETIC_THRESHOLD) {
            enc2_send = 1; enc2_accumulator -= MAGNETIC_THRESHOLD; activate = 1;
        } else if (enc2_accumulator <= -MAGNETIC_THRESHOLD) {
            enc2_send = -1; enc2_accumulator += MAGNETIC_THRESHOLD; activate = 1;
        }

        // 3. LECTURA GIROSCOPIO (MPU6050)
        uint8_t gyro_data[6];
        if(HAL_I2C_Mem_Read(&hi2c3, MPU6050_ADDR, 0x43, 1, gyro_data, 6, 10) == HAL_OK) {
            err_gyro = 0;
            gyro_x = (int16_t)((gyro_data[0] << 8) | gyro_data[1]);
            gyro_y = (int16_t)((gyro_data[2] << 8) | gyro_data[3]);
            gyro_z = (int16_t)((gyro_data[4] << 8) | gyro_data[5]);

            if(gyro_x > -GYRO_DEADZONE && gyro_x < GYRO_DEADZONE) gyro_x = 0;
            if(gyro_y > -GYRO_DEADZONE && gyro_y < GYRO_DEADZONE) gyro_y = 0;
            if(gyro_z > -GYRO_DEADZONE && gyro_z < GYRO_DEADZONE) gyro_z = 0;

            if(gyro_x != 0 || gyro_y != 0 || gyro_z != 0) activate = 1;
        } else {
            err_gyro = 1;
        }

        // 4. LECTURA INFRARROJO (FC-03)
        ir_velocidad = ir_ticks - ir_last_ticks;
        ir_last_ticks = ir_ticks;
        if(ir_velocidad > 0) activate = 1;

        // 5. RECEPCIÓN UNITY -> VIBRACIÓN
        if(mensaje_completo == 1) {
            int fuerza_motor = 0;
            if(sscanf((char*)rx_buffer, "V1:%d", &fuerza_motor) == 1) {
                TIM2->CCR1 = fuerza_motor; // Actualiza PA0
            }
            else if(sscanf((char*)rx_buffer, "V2:%d", &fuerza_motor) == 1) {
                TIM2->CCR2 = fuerza_motor; // Actualiza PA1
            }
            mensaje_completo = 0;
        }

        // 6. LED RGB CÍCLICO (PA10, PA11, PA12)
        if (HAL_GetTick() - led_timer >= 500) {
            led_timer = HAL_GetTick();

            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_10, GPIO_PIN_RESET); // Rojo
            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_RESET); // Verde
            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_12, GPIO_PIN_RESET); // Azul

            if(err_encoder == 0 && err_gyro == 0 && err_ir == 0) {
                if(led_step % 2 != 0) HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_SET);
            } else {
                if(led_step == 1 && err_encoder) HAL_GPIO_WritePin(GPIOA, GPIO_PIN_10, GPIO_PIN_SET);
                else if(led_step == 3 && err_ir) HAL_GPIO_WritePin(GPIOA, GPIO_PIN_12, GPIO_PIN_SET);
                else if(led_step == 5 && err_gyro) HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_SET);
            }
            led_step++;
            if(led_step > 6) led_step = 0;
        }

        // 7. ENVÍO DE DATOS A UNITY
        if (btn1 || btn2 || btn3 || btn4 || btn_suction || activate == 1) {
            printf("B1:%d B2:%d B3:%d B4:%d Su:%d E1:%d E2:%d IR:%ld IRV:%ld GX:%d GY:%d GZ:%d\r\n",
                   btn1, btn2, btn3, btn4, btn_suction,
                   enc1_send, enc2_send,
                   ir_ticks, ir_velocidad,
                   (gyro_x/100), (gyro_y/100), (gyro_z/100));

            activate = 0;
            enc1_send = 0;
            enc2_send = 0;
        }

        HAL_Delay(10); // Framerate del hardware (10ms = 100hz)
    }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

