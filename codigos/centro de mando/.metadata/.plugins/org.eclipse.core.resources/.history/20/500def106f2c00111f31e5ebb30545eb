uint8_t btn1, btn2, btn3, btn4, btn_suction;
uint8_t b1_last=0, b2_last=0, b3_last=0, b4_last=0, bs_last=0;
uint16_t angulo_anterior_1 = 0, angulo_anterior_2 = 0;
