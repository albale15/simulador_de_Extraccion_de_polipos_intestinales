/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{


  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  while (1)
  {
	  // Debounce de botones (btn3 ahora en PA10)
	          btn1 = readButton(GPIOA, GPIO_PIN_1, &b1_last);
	          btn2 = readButton(GPIOA, GPIO_PIN_4, &b2_last);
	          btn3 = readButton(GPIOA, GPIO_PIN_7, &b3_last);   // <-- CAMBIO
	          btn4 = readButton(GPIOA, GPIO_PIN_9, &b4_last);
	          btn_suction = readButton(GPIOA, GPIO_PIN_10, &bs_last);

	          // Lectura cruda de Encoder 1 (ahora en PA5/PA6)
	          uint8_t enc1_A_raw = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_5);
	          uint8_t enc1_B_raw = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_6);

	          // Lectura cruda de Encoder 2 (PB0/PB1)
	          uint8_t enc2_A_raw = HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_0);
	          uint8_t enc2_B_raw = HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_1);

	          // Filtros
	          enc1_A_filtered = alpha * enc1_A_raw + (1 - alpha) * enc1_A_filtered;
	          enc1_B_filtered = alpha * enc1_B_raw + (1 - alpha) * enc1_B_filtered;
	          enc2_A_filtered = alpha * enc2_A_raw + (1 - alpha) * enc2_A_filtered;
	          enc2_B_filtered = alpha * enc2_B_raw + (1 - alpha) * enc2_B_filtered;

	          // Estados
	          uint8_t enc1_state = ((enc1_A_filtered > 0.5f) << 1) | (enc1_B_filtered > 0.5f);
	          uint8_t enc2_state = ((enc2_A_filtered > 0.5f) << 1) | (enc2_B_filtered > 0.5f);

	          // Lógica cuadratura Encoder 1
	          switch ((enc1_last_state << 2) | enc1_state) {
	          	  case 0b0001: case 0b0111: case 0b1110: case 0b1000:
	          		  enc1_delta = 1;
	          		  break;
	          	  case 0b0010: case 0b0100: case 0b1101: case 0b1011:
	          		  enc1_delta = -1;
	          		  break;
	          }
	          enc1_last_state = enc1_state;
	          // ---- Lógica cuadratura para encoder 2 ----
	          switch ((enc2_last_state << 2) | enc2_state) {
	          	  case 0b0001: case 0b0111: case 0b1110: case 0b1000:
	          		  enc2_delta = 1;
	          		  break;
	          	  case 0b0010: case 0b0100: case 0b1101: case 0b1011:
	          		  enc2_delta = -1;
	          		  break;
	          }
	          enc2_last_state = enc2_state;

	          //arreglo por no havber uso todavia de encoder 2
	          //enc1_delta=0;
	          //enc2_delta=0;


	          if (enc1_delta==1)
	          {
	        	  enc1_accumulator +=1;
	          	  enc1_accumulator2 =0;
	          	  enc1_send=enc1_delta;
	          	  enc1_delta = 0;
	          }
	          else if (enc1_delta==-1)
	          {
	        	  enc1_accumulator =0;
	        	  enc1_accumulator2 +=1;
	        	  enc1_send=enc1_delta;
	        	  enc1_delta = 0; }
	          if (enc2_delta==1)
	          {
	        	  enc2_accumulator +=1;
	        	  enc2_accumulator2 =0;
	        	  enc2_send=enc2_delta;
	        	  enc2_delta = 0;
	          }
	          else if (enc2_delta==-1)
	          {
	        	  enc2_accumulator =0;
	        	  enc2_accumulator2 +=1;
	        	  enc2_send=enc2_delta;
	        	  enc2_delta = 0;
	          }
	          if (SENSITIVITY_THRESHOLD<=enc1_accumulator||SENSITIVITY_THRESHOLD<=enc1_accumulator2||SENSITIVITY_THRESHOLD<=enc2_accumulator||SENSITIVITY_THRESHOLD<=enc2_accumulator2)
	          {
	        	  activate = 1;
	        	  enc1_accumulator =0;
	        	  enc1_accumulator2 =0;
	        	  enc2_accumulator =0;
	        	  enc2_accumulator2 =0;
	          }

	          // LED
	          if (btn1 || btn2 || btn3 || btn4 || btn_suction)
	              HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_SET);
	          else
	              HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_RESET);

	          // Envío
	          if (btn1 || btn2 || btn3 || btn4 || btn_suction || activate == 1)
	          {
	              printf("B1:%d B2:%d B3:%d B4:%d Su:%d E1:%d E2:%d\r\n",
	                     btn1, btn2, btn3, btn4, btn_suction, enc1_send, enc2_send);
	              activate = 0;
	              enc1_send = 0;
	              enc2_send = 0;
	          }

	          HAL_Delay(10);
	      }
  /* USER CODE END 3 */
}

