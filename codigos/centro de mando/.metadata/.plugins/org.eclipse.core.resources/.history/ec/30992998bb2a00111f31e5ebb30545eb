/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{


  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  while (1)
  {
	  // 1. Debounce de botones (Reubicados a PA0 - PA4 para evitar conflictos)
	        btn1 = readButton(GPIOA, GPIO_PIN_0, &b1_last);
	        btn2 = readButton(GPIOA, GPIO_PIN_1, &b2_last);
	        btn3 = readButton(GPIOA, GPIO_PIN_2, &b3_last);
	        btn4 = readButton(GPIOA, GPIO_PIN_3, &b4_last);
	        btn_suction = readButton(GPIOA, GPIO_PIN_4, &bs_last);

	        // 2. Lectura de Encoders Magnéticos
	        uint16_t angulo_actual_1 = Leer_Angulo_AS5600(&hi2c1);
	        uint16_t angulo_actual_2 = Leer_Angulo_AS5600(&hi2c3);

	        // 3. Calcular la diferencia de giro (Delta)
	        int16_t diff_1 = angulo_actual_1 - angulo_anterior_1;
	        int16_t diff_2 = angulo_actual_2 - angulo_anterior_2;

	        // Magia matemática: Corregir el cruce por cero (ej. pasar del grado 4095 al 0)
	        if (diff_1 > 2048) diff_1 -= 4096;
	        if (diff_1 < -2048) diff_1 += 4096;
	        if (diff_2 > 2048) diff_2 -= 4096;
	        if (diff_2 < -2048) diff_2 += 4096;

	        // Actualizar variables
	        angulo_anterior_1 = angulo_actual_1;
	        angulo_anterior_2 = angulo_actual_2;

	        // Acumular la distancia recorrida
	        enc1_accumulator += diff_1;
	        enc2_accumulator += diff_2;

	        // 4. Generar "Clics Virtuales" para Unity
	        if (enc1_accumulator >= MAGNETIC_THRESHOLD) {
	            enc1_send = 1;
	            enc1_accumulator -= MAGNETIC_THRESHOLD; // Descontamos el umbral
	            activate = 1;
	        } else if (enc1_accumulator <= -MAGNETIC_THRESHOLD) {
	            enc1_send = -1;
	            enc1_accumulator += MAGNETIC_THRESHOLD;
	            activate = 1;
	        }

	        if (enc2_accumulator >= MAGNETIC_THRESHOLD) {
	            enc2_send = 1;
	            enc2_accumulator -= MAGNETIC_THRESHOLD;
	            activate = 1;
	        } else if (enc2_accumulator <= -MAGNETIC_THRESHOLD) {
	            enc2_send = -1;
	            enc2_accumulator += MAGNETIC_THRESHOLD;
	            activate = 1;
	        }

	        // 5. LED de estado
	        if (btn1 || btn2 || btn3 || btn4 || btn_suction)
	            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_SET);
	        else
	            HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_RESET);

	        // 6. Envío JSON a Unity
	        if (btn1 || btn2 || btn3 || btn4 || btn_suction || activate == 1) {
	            printf("B1:%d B2:%d B3:%d B4:%d Su:%d E1:%d E2:%d\r\n",
	                   btn1, btn2, btn3, btn4, btn_suction, enc1_send, enc2_send);
	            activate = 0;
	            enc1_send = 0;
	            enc2_send = 0;
	        }

	        HAL_Delay(10); // Pausa general de ciclo
	      }
  /* USER CODE END 3 */
}

