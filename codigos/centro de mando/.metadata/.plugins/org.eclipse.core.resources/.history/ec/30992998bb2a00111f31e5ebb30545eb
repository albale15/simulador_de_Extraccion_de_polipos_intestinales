// Variables de botones
uint8_t btn1, btn2, btn3, btn4, btn_suction;
uint8_t b1_last = 0, b2_last = 0, b3_last = 0, b4_last = 0, bs_last = 0;

// Variables para Encoders Magnéticos AS5600
uint16_t angulo_anterior_1 = 0;
uint16_t angulo_anterior_2 = 0;
int32_t enc1_accumulator = 0;
int32_t enc2_accumulator = 0;

// Sensibilidad Magnética
// El AS5600 tiene 4096 pasos. Un umbral de 200 equivale a unos 20 "clics" virtuales por vuelta.
// subir este número si gira muy rápido en Unity, o bajarlo si gira muy lento.
const int32_t MAGNETIC_THRESHOLD = 200;

int8_t enc1_send = 0;
int8_t enc2_send = 0;
int8_t activate = 0;
/* USER CODE END PV */

